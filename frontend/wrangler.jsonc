{
  // TradeWood static site on Cloudflare Workers (static assets, no server code).
  // Workers Builds: root directory = frontend, build = `npm ci --legacy-peer-deps && npm run build`, deploy = `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradewood",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "tradewood.app", "custom_domain": true },
    { "pattern": "www.tradewood.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
