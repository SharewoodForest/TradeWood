# Copy to .env and fill in. NEVER commit .env.
DEPLOYER_PRIVATE_KEY=
TREASURY_WALLET_ADDRESS=
# Optional — defaults to deployer. Use a multisig (e.g. Safe) for mainnet.
OWNER_ADDRESS=
# Optional — mainnet defaults to the verified Uniswap V2 router; required on testnet.
ROUTER_ADDRESS=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
